{
  "name": "level3-approval-gate",
  "version": "1.0.0",
  "description": "A sample repository that shows how an AI can approve part of the changes in a repository, safely.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "gate:types": "tsc --noEmit",
    "gate:tests": "vitest run --coverage",
    "gate:diff-coverage": "tsx scripts/cli.ts diff-coverage",
    "gate:lint": "eslint .",
    "gate:complexity": "eslint --config eslint.complexity.config.js src scripts",
    "gate:architecture": "depcruise src scripts tests --config .dependency-cruiser.cjs",
    "gate:semgrep": "docker run --rm -v \"$PWD:/src\" -w /src semgrep/semgrep@sha256:6e1b04340e60e910fbb4ddbf3c857ab0918f064417ad5ac530014ccb3cf8c8f1 semgrep scan --config p/typescript --config p/security-audit --error --metrics=off",
    "gate:gitleaks": "docker run --rm -v \"$PWD:/repo\" ghcr.io/gitleaks/gitleaks@sha256:c00b6bd0aeb3071cbcb79009cb16a60dd9e0a7c60e2be9ab65d25e6bc8abbb7f detect --source /repo --redact --verbose --log-opts=\"${GITLEAKS_RANGE:-origin/main..HEAD}\"",
    "gate:osv": "docker run --rm -v \"$PWD:/src\" -w /src ghcr.io/google/osv-scanner@sha256:a70ffffc2bfd33482953e5d6b64c6fcdb30239717a07b0f0d3ab2859ce3e4cde --lockfile=package-lock.json",
    "gate:suppressions": "tsx scripts/cli.ts suppressions --base ${DIFF_BASE:-origin/main}",
    "gate:ratchet": "tsx scripts/cli.ts ratchet --base ${DIFF_BASE:-origin/main}",
    "gate:lane": "tsx scripts/cli.ts lane --base ${DIFF_BASE:-origin/main}",
    "gate:local": "npm run gate:types && npm run gate:tests && npm run gate:lint && npm run gate:complexity && npm run gate:architecture && npm run gate:suppressions && npm run gate:ratchet && npm run gate:lane",
    "audit": "tsx scripts/cli.ts audit",
    "test:mutation": "stryker run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "^22.20.7",
    "@types/picomatch": "^4.0.3",
    "@vitest/coverage-v8": "^5.1.2",
    "dependency-cruiser": "^18.9.0",
    "eslint": "^10.15.0",
    "ignore": "^7.0.17",
    "picomatch": "^4.0.7",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2",
    "yaml": "^2.9.1"
  }
}
