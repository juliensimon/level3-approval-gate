# Owner: a person, never an agent or a bot. In your fork, replace @juliensimon with a team of people, for example @your-org/gate-owners.
#
# These are the red-lane paths from LANES.md and the files that judge a change.
# The ruleset requires a code owner review, so a person always approves a change here.
# Keep this file in step with gate/lanes.json. tests/scripts/lane.test.ts checks it.

# Any dotfile or dot-directory at the repository root (tool configuration)
/.*                      @juliensimon

# CI, review rules and ownership
/.github/                @juliensimon
CODEOWNERS               @juliensimon
/rulesets/               @juliensimon
/LANES.md                @juliensimon

# The gate's own configuration, thresholds and scripts
/gate/                   @juliensimon
/scripts/                @juliensimon
/eslint.config.*         @juliensimon
/eslint.*.config.*       @juliensimon
/vitest.config.*         @juliensimon
/stryker.*               @juliensimon
/tsconfig*.json          @juliensimon
/osv-scanner.toml        @juliensimon

# Dependencies
/package.json            @juliensimon
/package-lock.json       @juliensimon

# Security, permissions and data
security/                @juliensimon
auth/                    @juliensimon
secrets/                 @juliensimon
permissions/             @juliensimon
migrations/              @juliensimon

# AI features: prompts and evaluation sets
/prompts/                @juliensimon
/evals/                  @juliensimon
